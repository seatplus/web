includes:
    - vendor/larastan/larastan/extension.neon
    # Pest-aware static analysis (understands it()/expect()/$this).
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    # Understands Mockery's dynamic API (shouldReceive(), etc.).
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    configDirectories:
    - config

    databaseMigrationsPath:
        - database/migrations
        - vendor/seatplus/auth/database/migrations
        - vendor/seatplus/eveapi/database/migrations
    level: 4
    paths:
        - src
        - config
        - database
        - tests
    # Browser tests run in core (with pest-plugin-browser, which isn't a web dep);
    # web's phpunit excludes them too, so PHPStan can't resolve Pest\Browser\* here.
    excludePaths:
        - tests/Browser
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # ---------------------------------------------------------------------------
        # Root-caused upstream in eveapi; these go away with the release that carries
        # the fixes, not by being fixed here.
        # ---------------------------------------------------------------------------
        # filterBy*Ids are query scopes on the watch-list models. The WatchList
        # interfaces do not declare them, so they are invisible on the raw Builder.
        -
            message: "#^Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Builder.*::filterBy(System|Region)Ids\\(\\)\\.$#"
            path: src/Services/Query/LocationWatchListScope.php
        -
            message: "#^Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Builder.*::filterBy(Type|Group|Category)Ids\\(\\)\\.$#"
            path: src/Services/Query/TypeWatchListScope.php
        # CharacterInfo::corporation() is an ungenerified HasOneThrough, so the related
        # CorporationInfo degrades to a bare Eloquent Model.
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$corporation_id#'
            paths:
                - tests/Feature/ContactTest.php
                - tests/Unit/Middleware/CheckRequiredScopesMiddlewareTest.php
        # RefreshToken::$token is an Attribute accessor Larastan infers as never.
        -
            identifier: assign.propertyType
            path: tests/Pest.php
        # SsoScopes casts selected_scopes to array in casts(); Larastan does not read the
        # method form and falls back to the text column type.
        -
            identifier: pest.expectation.requiresCountableOrIterable
            path: tests/Unit/Services/SsoSettings/UpdateOrCreateSsoSettingsTest.php

        # ---------------------------------------------------------------------------
        # Pest's test() is typed as TestCall — only expect() has a return-type
        # extension — so every test()->property and test()->method() is unresolvable.
        # Removed by the follow-up that converts test()-> to $this->, which the plugin
        # binds to the TestCase.
        # ---------------------------------------------------------------------------
        -
            message: '#Access to an undefined property Pest\\(PendingCalls\\TestCall|Support\\HigherOrderTapProxy).*::\$#'
            paths:
                - tests/*
        -
            message: '#Call to an undefined method Pest\\(PendingCalls\\TestCall|Support\\HigherOrderTapProxy)#'
            paths:
                - tests/*
