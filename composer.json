{
    "name": "seatplus/web",
    "description": "Web frontend of seatplus",
    "license": "MIT",
    "authors": [
        {
            "name": "Felix Huber",
            "email": "felix.a.huber@gmx.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "Seatplus\\Web\\": "src/",
            "Seatplus\\Web\\Database\\Factories\\": "database/factories"
        },
        "files": [
            "./src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Seatplus\\Web\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/socialite": "^5.0",
        "seatplus/eveapi": "dev-chore/code-quality as 4.0.7",
        "seatplus/auth": "dev-4.x-laravel11-quality as 4.0.6",
        "conedevelopment/i18n": "^1.1",
        "doctrine/dbal": "^3.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/wayfinder": "^0.1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "nunomaduro/collision": "^8.1",
        "rector/rector": "^2.0",
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.9",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Seatplus\\Web\\WebServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/seatplus/auth.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/seatplus/eveapi.git"
        }
    ],
    "scripts": {
        "lint": "vendor/bin/pint",
        "test:lint": "vendor/bin/pint --test",
        "test:types": "vendor/bin/phpstan --ansi",
        "test:type-coverage": "vendor/bin/pest --type-coverage --min=100",
        "test:unit": "vendor/bin/pest --colors=always --no-coverage",
        "test:unit-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
