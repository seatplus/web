{
    "name": "seatplus/web",
    "description": "Web frontend of seatplus",
    "license": "MIT",
    "authors": [
        {
            "name": "Felix Huber",
            "email": "felix.a.huber@gmx.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "Seatplus\\Web\\": "src/",
            "Seatplus\\Web\\Database\\Factories\\": "database/factories"
        },
        "files": [
            "./src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Seatplus\\Web\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.0",
        "seatplus/eveapi": "^5.0",
        "seatplus/auth": "^5.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/wayfinder": "^0.1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "nunomaduro/collision": "^8.1",
        "rector/rector": "^2.0",
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.9",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Seatplus\\Web\\WebServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test:lint": "vendor/bin/pint --test",
        "test:types": "vendor/bin/phpstan --ansi",
        "test:type-coverage": "__PEST_PLUGIN_ENV=1 vendor/bin/pest --type-coverage --min=100",
        "test:unit": "vendor/bin/pest --tia --colors=always",
        "test:unit-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
